---
import BaseLayout from "../layouts/BaseLayout.astro";

const socialLinks = [
  { label: "GitHub", href: "https://github.com/moughamir" },
  { label: "LinkedIn", href: "https://linkedin.com/in/moughamir" },
  { label: "Substack", href: "https://moughamir.substack.com" },
  { label: "Email", href: "mailto:moughamir@gmail.com" },
];
---

<BaseLayout
    title="Mohamed Moughamir — Full-Stack Engineer & Project Coordinator"
    description="Full-stack engineer across web, mobile, and infrastructure. End-to-end project coordination — I lead projects from scope to production. Based in Morocco."
    hideNav={true}
>
    <main class="landing">
        <!-- Decorative background elements -->
        <div class="bg-grid" aria-hidden="true"></div>
        <div class="bg-accent" aria-hidden="true"></div>

        <section class="hero wrapper">
            <div class="hero-inner">
                <div class="badge-wrapper">
                    <span class="status-dot"></span>
                    <span class="status-text">Available for work</span>
                </div>

                <h1 class="name">
                    Mohamed<br />
                    <span class="name-accent">Moughamir</span>
                </h1>

                <p class="role">Full-Stack Engineer &amp; Project Coordinator</p>

                <p class="tagline">
                    Full-stack across <strong>web</strong>, <strong>mobile</strong>, and <strong>infrastructure</strong>.
                    I scope, coordinate, and ship production systems end-to-end.
                </p>

                <div class="ctas">
                    <a href="/work/" class="brutal-btn">
                        View work
                        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M1 8h12M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a href="/hire/" class="brutal-btn outline">Let's talk</a>
                </div>
            </div>

            <nav class="social" aria-label="Social links">
                {socialLinks.map(({ label, href }) => (
                    <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
                ))}
            </nav>
        </section>

        <!--
          Pointer to the agentic systems page (/agentic/). Content lives in
          public/agentic/ and is served verbatim by the Astro build.

          This is the D-4 outcome: jev ranked keep-both-unlinked (54%) above
          link-root-to-agentic (40%), but that ruling came at only 39% confidence
          and the two were close. Linking is strictly better than not linking —
          same two pages, but /agentic/ is discoverable instead of orphaned — so
          it was applied. The Astro build had hung earlier under load; retried on
          a quiet machine it succeeds.
        -->
        <section class="agentic-cta wrapper">
            <p class="agentic-lede">
                This machine runs a verified OS layer and a four-node agent
                network that exchanges real messages. The telemetry is measured
                from the live system, not decorated.
            </p>
            <a class="agentic-link" href="/agentic/">
                Agentic systems &rarr;
            </a>
        </section>

    </main>
</BaseLayout>

<style>
    .agentic-cta {
        border-top: 1px solid var(--color-base-content, #2a2a2a);
        padding-top: 2rem;
        margin-top: 3rem;
        padding-bottom: 3rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: flex-start;
    }
    .agentic-lede {
        max-width: 46ch;
        opacity: 0.7;
        line-height: 1.6;
    }
    .agentic-link {
        font-weight: 700;
        text-decoration: none;
        border-bottom: 2px solid currentColor;
        padding-bottom: 2px;
        transition: opacity 0.2s ease;
    }
    .agentic-link:hover { opacity: 0.7; }
    /* =========================================================
       Layout
       ========================================================= */

    .landing {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    /* =========================================================
       Background Elements
       ========================================================= */

    .bg-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(var(--gray-700) 1px, transparent 1px),
            linear-gradient(90deg, var(--gray-700) 1px, transparent 1px);
        background-size: 4rem 4rem;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 20%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 20%, transparent 70%);
        pointer-events: none;
    }

    .bg-accent {
        position: absolute;
        top: -10%;
        right: -15%;
        width: 25rem;
        height: 25rem;
        background: radial-gradient(circle, color-mix(in srgb, var(--accent-regular) 8%, transparent) 0%, transparent 70%);
        pointer-events: none;
    }

    /* =========================================================
       Hero
       ========================================================= */

    .hero {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 5rem 0 2.5rem;
        position: relative;
        z-index: 1;
    }

    .hero-inner {
        max-width: 52rem;
    }

    /* Status Badge */

    .badge-wrapper {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 0.75rem;
        margin-bottom: 2rem;
        border: 1px solid var(--gray-700);
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--gray-300);
        white-space: nowrap;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-success);
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    .status-text {
        line-height: 1;
    }

    /* Name */

    .name {
        font-family: var(--font-brand);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        color: var(--gray-0);
        line-height: 0.95;
        font-size: clamp(3rem, 14vw, 7rem);
        margin: 0 0 1rem 0;
    }

    .name-accent {
        color: var(--accent-regular);
    }

    /* Role */

    .role {
        font-family: var(--font-mono);
        font-size: clamp(0.85rem, 1.5vw, 1rem);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--gray-200);
        margin: 0 0 1.5rem 0;
    }

    /* Tagline */

    .tagline {
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        line-height: 1.6;
        color: var(--gray-300);
        max-width: 48ch;
        margin: 0 0 2.5rem 0;
    }

    .tagline strong {
        color: var(--gray-0);
        font-weight: 600;
    }

    /* CTAs */

    .ctas {
        display: flex;
        gap: 0.75rem;
    }

    .btn-arrow {
        transition: transform 0.2s ease;
    }

    .brutal-btn:hover .btn-arrow {
        transform: translateX(3px);
    }

    .outline {
        background: transparent;
        color: var(--gray-0);
        border: 2px solid var(--gray-0);
    }

    .outline:hover {
        background: var(--gray-0);
        color: var(--gray-999);
        box-shadow: 4px 4px 0 0 var(--gray-0);
    }

    /* =========================================================
       Social
       ========================================================= */

    .social {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-700);
    }

    .social a {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--gray-400);
        text-decoration: none;
        transition: color 0.15s ease;
        position: relative;
        padding: 0.5rem 0.75rem;
        margin: -0.5rem -0.75rem;
        -webkit-tap-highlight-color: transparent;
    }

    .social a::after {
        content: "";
        position: absolute;
        bottom: 4px;
        left: 0.75rem;
        width: 0;
        height: 1.5px;
        background: var(--accent-regular);
        transition: width 0.2s ease;
    }

    .social a:hover {
        color: var(--accent-regular);
    }

    .social a:hover::after {
        width: calc(100% - 1.5rem);
    }

    /* =========================================================
       Reduced Motion
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {
        .status-dot {
            animation: none;
            opacity: 1;
        }

        .brutal-btn:hover {
            transform: none;
        }

        .btn-arrow {
            transition: none;
        }

        .brutal-btn:hover .btn-arrow {
            transform: none;
        }

        .outline:hover {
            transform: none;
        }

        .social a::after {
            transition: none;
        }
    }

    /* =========================================================
       Responsive — Small Phones (≤30em / ≤480px)
       ========================================================= */

    @media (max-width: 30em) {
        .bg-grid {
            background-size: 3rem 3rem;
            mask-image: radial-gradient(ellipse 100% 50% at 50% 25%, black 20%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse 100% 50% at 50% 25%, black 20%, transparent 70%);
        }

        .bg-accent {
            width: 15rem;
            height: 15rem;
            top: -5%;
            right: -20%;
        }

        .hero {
            padding: 3.5rem 0 1.5rem;
        }

        .hero-inner {
            max-width: 100%;
        }

        .badge-wrapper {
            padding: 0.25rem 0.6rem;
            font-size: 0.6rem;
            margin-bottom: 1.25rem;
        }

        .name {
            font-size: clamp(2.25rem, 13vw, 3rem);
            letter-spacing: -0.02em;
            margin-bottom: 0.75rem;
        }

        .role {
            font-size: clamp(0.75rem, 2.5vw, 0.85rem);
            margin-bottom: 1rem;
        }

        .tagline {
            font-size: 0.95rem;
            line-height: 1.55;
            margin-bottom: 1.75rem;
        }

        .ctas {
            flex-direction: column;
            gap: 0.65rem;
        }

        .brutal-btn {
            width: 100%;
            padding: 0.9rem 1.5rem;
            font-size: 0.8rem;
            text-align: center;
        }

        .social {
            gap: 0.25rem;
            margin-top: 2rem;
            padding-top: 1.25rem;
        }

        .social a {
            font-size: 0.72rem;
            padding: 0.45rem 0.6rem;
            margin: -0.45rem -0.6rem;
        }

        .social a::after {
            bottom: 3px;
            left: 0.6rem;
        }

        .social a:hover::after {
            width: calc(100% - 1.2rem);
        }
    }

    /* =========================================================
       Responsive — Large Phones / Small Tablets (30em–50em)
       ========================================================= */

    @media (min-width: 30.001em) and (max-width: 49.999em) {
        .bg-grid {
            background-size: 4rem 4rem;
        }

        .bg-accent {
            width: 20rem;
            height: 20rem;
        }

        .hero {
            padding: 5rem 0 2.5rem;
        }

        .name {
            font-size: clamp(3rem, 12vw, 4.5rem);
        }

        .social {
            gap: 1rem;
            margin-top: 2.5rem;
        }

        .social a {
            font-size: 0.75rem;
        }
    }

    /* =========================================================
       Responsive — Tablet / Desktop (≥50em / ≥800px)
       ========================================================= */

    @media (min-width: 50em) {
        .bg-grid {
            background-size: 6rem 6rem;
            mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 20%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 20%, transparent 70%);
        }

        .bg-accent {
            top: -20%;
            right: -10%;
            width: 40rem;
            height: 40rem;
        }

        .hero {
            padding: 8rem 0 4rem;
        }

        .badge-wrapper {
            padding: 0.35rem 0.85rem;
            font-size: 0.7rem;
            margin-bottom: 2.5rem;
        }

        .social {
            gap: 2rem;
            margin-top: 5rem;
            padding-top: 2rem;
        }
    }

    /* =========================================================
       Responsive — Wide Desktop (≥80em / ≥1280px)
       ========================================================= */

    @media (min-width: 80em) {
        .hero {
            padding: 10rem 0 5rem;
        }

        .hero-inner {
            max-width: 56rem;
        }

        .social {
            margin-top: 6rem;
        }
    }

    /* =========================================================
       Responsive — Landscape on short viewports
       ========================================================= */

    @media (max-height: 500px) and (orientation: landscape) {
        .landing {
            min-height: auto;
        }

        .hero {
            padding: 2rem 0 1rem;
        }

        .badge-wrapper {
            margin-bottom: 0.75rem;
        }

        .name {
            font-size: clamp(1.75rem, 8vh, 2.5rem);
            margin-bottom: 0.25rem;
        }

        .role {
            margin-bottom: 0.5rem;
        }

        .tagline {
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .ctas {
            flex-direction: row;
        }

        .brutal-btn {
            width: auto;
            padding: 0.5rem 1.25rem;
        }

        .social {
            margin-top: 1rem;
            padding-top: 0.75rem;
        }

        .bg-accent {
            opacity: 0.4;
        }
    }

    /* =========================================================
       Dark mode overrides
       ========================================================= */

    :root.theme-dark .bg-grid {
        --gray-700: #27272a;
    }

    :root.theme-dark .bg-accent {
        background: radial-gradient(circle, color-mix(in srgb, var(--accent-regular) 10%, transparent) 0%, transparent 70%);
    }
</style>
