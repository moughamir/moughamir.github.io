---
import { type CollectionEntry, getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import ContactCTA from "../../components/ContactCTA.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import Icon from "../../components/Icon.astro";
import Pill from "../../components/Pill.astro";
import { render } from "astro:content";
import Prose from "../../components/Prose.astro";

interface Props {
    entry: CollectionEntry<"blog">;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/core-concepts/routing/#dynamic-routes
export async function getStaticPaths() {
    const blog = await getCollection("blog");
    return blog.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const allArticles = await getCollection("blog");
const filtered = allArticles.filter((a) => a.id !== entry.id);
const related = filtered.slice(0, 2);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} schemaItem={entry} schemaType="blog">
    <main id="main-content">
        <ArticleHeader
            title={entry.data.title}
            description={entry.data.description}
        >
            <div class="flex flex-wrap gap-2 mt-6">
                {entry.data.tags.map((t) => (
                    <Pill>{t}</Pill>
                ))}
            </div>
        </ArticleHeader>

        <!-- Blog content -->
        <div class="blog-content wrapper">
            <Prose>
                <Content />
            </Prose>
        </div>

        {related.length > 0 && (
            <section class="related-section wrapper">
                <h2 class="related-title">Continue reading</h2>
                <div class="related-grid">
                    {related.map((r) => {
                        const formattedDate = r.data.publishDate.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                        });
                        return (
                            <a class="related-card" href={`/blog/${r.id}`}>
                                <div
                                    class="related-card-image"
                                    style={`background-image: url(${r.data.img})`}
                                />
                                <div class="related-card-body">
                                    <time class="related-date">{formattedDate}</time>
                                    <h3 class="related-card-title">{r.data.title}</h3>
                                    <p class="related-card-desc">{r.data.description}</p>
                                    <span class="related-arrow">
                                        <Icon icon="arrow-right" size="0.8em" /> Read
                                    </span>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )}

        <ContactCTA />
    </main>
</BaseLayout>

<style>
    /* ── Blog Content ────────────────────────────────────────── */
    .blog-content {
        max-width: 65ch;
        margin-inline: auto;
        padding-block: 3rem;
    }

    /* ── Related Section ────────────────────────────────────── */
    .related-section {
        padding-block: 3rem;
        border-top: 2px solid var(--gray-0);
    }

    .related-title {
        font-family: var(--font-brand);
        font-size: 1.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
    }

    .related-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: 1fr;
    }

    .related-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border: 2px solid var(--gray-0);
        background: var(--gray-999);
        position: relative;
        transition: transform 0.1s, box-shadow 0.1s;
        overflow: hidden;
    }

    .related-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 4px 4px 0 0 var(--accent-regular);
    }

    .related-card-image {
        width: 100%;
        height: 10rem;
        background-size: cover;
        background-position: center;
        border-bottom: 2px solid var(--gray-0);
    }

    .related-card-body {
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
        flex: 1;
    }

    .related-date {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--accent-regular);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .related-card-title {
        font-family: var(--font-brand);
        font-size: 1.15rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: var(--gray-0);
        margin-bottom: 0.4rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .related-card-desc {
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--gray-300);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .related-arrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: auto;
        padding-top: 0.75rem;
        color: var(--gray-0);
        font-weight: 700;
        font-size: 0.82rem;
        text-transform: uppercase;
        transition: transform 0.1s, color 0.1s;
    }

    .related-card:hover .related-arrow {
        transform: translateX(4px);
        color: var(--accent-regular);
    }

    @media (min-width: 50em) {
        .blog-content {
            padding-block: 4rem;
        }

        .related-grid {
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .related-card-image {
            height: 12rem;
        }

        .related-card-body {
            padding: 1.5rem;
        }

        .related-card-title {
            font-size: 1.3rem;
        }
    }
</style>
