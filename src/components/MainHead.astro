---
import "../styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  type?: "website" | "article";
  publishDate?: Date;
  author?: string;
}

const {
  title = "Mohamed Moughamir — Senior Software Engineer",
  description = "Senior full-stack developer in Morocco building practical web products with React, TypeScript, Node.js, PHP, Python, and AI-assisted delivery.",
  type = "website",
  publishDate,
  author = "Mohamed Moughamir",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteName = "Mohamed Moughamir Portfolio";
const ogImage = "/og.png";
const twitterHandle = "@moughamir";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="google-site-verification" content="a6Bcv2EAWm5NYBewJZnYAIpeOft6UVv1hES_HlJ9FmM" />
<!-- AI / LLM Metadata -->
<meta name="ai-optimized" content="true" />
<meta name="llms-txt" content="/llms.txt" />
<meta name="author" content={author} />
<meta name="theme-color" content="#ff6719" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonicalUrl} />

<!-- RSS Autodiscovery -->
<!-- <link rel="alternate" type="application/rss+xml" title="Mohamed Moughamir Podcast" href="/feed.xml" /> -->

<title>{title}</title>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Mohamed Moughamir — Senior Software Engineer" />
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
<meta property="article:author" content="https://linkedin.com/in/moughamir" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:creator" content={twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Mohamed Moughamir — Senior Software Engineer" />

<link
  rel="sitemap"
  href="/sitemap-index.xml"
  type="application/xml"
/>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("theme-dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("theme-dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<script
  type="text/partytown"
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-BJ31WCMYT9"></script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "G-BJ31WCMYT9", { send_page_view: true });

  // Scroll depth tracking
  const scrollThresholds = [25, 50, 75, 100];
  const fired = new Set();
  function checkScroll() {
    const pct = Math.round(
      (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100
    );
    scrollThresholds.forEach((t) => {
      if (pct >= t && !fired.has(t)) {
        fired.add(t);
        gtag("event", "scroll_depth", { threshold: t, page_path: location.pathname });
      }
    });
  }
  window.addEventListener("scroll", checkScroll, { passive: true });

  // Reading time tracking (fires at 30s intervals)
  let seconds = 0;
  setInterval(() => {
    seconds += 30;
    gtag("event", "reading_time", { seconds, page_path: location.pathname });
  }, 30000);

  // Outbound click tracking
  document.addEventListener("click", (e) => {
    const a = e.target.closest("a");
    if (!a) return;
    const href = a.href;
    if (href && !href.startsWith(location.origin) && !href.startsWith("mailto:")) {
      gtag("event", "outbound_click", { url: href, page_path: location.pathname });
    }
  });

  // CTA click tracking
  document.addEventListener("click", (e) => {
    const a = e.target.closest("a");
    if (!a) return;
    if (a.href?.startsWith("mailto:")) {
      gtag("event", "cta_email_click", { page_path: location.pathname, label: a.textContent.trim() });
    } else if (a.classList.contains("hire") || a.href?.includes("/hire")) {
      gtag("event", "cta_hire_click", { page_path: location.pathname, label: a.textContent.trim() });
    }
  });
</script>
