---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const textLinks: { label: string; href: string }[] = [
  { label: "Work", href: "/work/" },
  { label: "Blog", href: "/blog/" },
  { label: "About", href: "/about/" },
];

const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
  if (pathname.at(0) !== "/") pathname = "/" + pathname;
  if (pathname.at(-1) !== "/") pathname += "/";
  return pathname === href || (href !== "/" && pathname.startsWith(href));
};
---

<nav class="side-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Mohamed Moughamir home">
      <Icon icon="terminal-window" size="1.25rem" />
    </a>

    <div class="nav-links">
      {textLinks.map(({ label, href }) => (
        <a
          aria-current={isCurrentPage(href) ? "page" : null}
          class:list={["nav-link", { active: isCurrentPage(href) }]}
          href={href}
        >
          {label}
        </a>
      ))}
    </div>

    <div class="nav-actions">
      <a href="https://moughamir.substack.com" class="nav-social" aria-label="Substack" target="_blank" rel="noopener noreferrer">
        <Icon icon="substack" size="1rem" />
      </a>
      <ThemeToggle />
      <a class="nav-cta" href="/hire/">Let's talk</a>
    </div>
  </div>
</nav>

<!-- Mobile Bottom Nav -->
<nav class="mobile-nav" aria-label="Mobile navigation">
  {textLinks.map(({ label, href }) => (
    <a aria-current={isCurrentPage(href) ? "page" : null} href={href}>{label}</a>
  ))}
  <a class="mobile-cta" href="/hire/">Talk</a>
</nav>

<style>
  .side-nav {
    position: fixed;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--gray-999);
    border: 2px solid var(--gray-0);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--gray-0);
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
    border-bottom: 1px solid var(--gray-700);
    padding-bottom: 1rem;
    margin-bottom: 0.25rem;
  }

  .nav-brand:hover {
    transform: translate(-2px, -2px);
    color: var(--accent-regular);
  }

  .nav-brand:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-link {
    font-family: var(--font-brand);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--gray-300);
    padding: 0.5rem 0.75rem;
    margin: -0.5rem -0.75rem;
    transition: color 0.15s ease, transform 0.15s ease;
    position: relative;
  }

  .nav-link::before {
    content: "";
    position: absolute;
    left: -0.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: var(--accent-regular);
    transition: height 0.15s ease;
  }

  .nav-link:hover {
    color: var(--gray-0);
    transform: translateX(4px);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }

  .nav-link.active {
    color: var(--accent-regular);
  }

  .nav-link.active::before {
    height: 100%;
  }

  .nav-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--gray-700);
  }

  .nav-social {
    color: var(--gray-400);
    transition: color 0.15s ease;
    display: flex;
    padding: 0.375rem;
    margin: -0.375rem;
  }

  .nav-social:hover {
    color: var(--accent-regular);
  }

  .nav-social:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }

  .nav-cta {
    font-family: var(--font-brand);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    background: var(--accent-regular);
    color: var(--accent-text-over);
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .nav-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 0 var(--accent-regular);
  }

  .nav-cta:focus-visible {
    outline: 2px solid var(--gray-0);
    outline-offset: 2px;
  }

  /* Mobile: hide side nav, show bottom bar */
  @media (max-width: 50em) {
    .side-nav {
      display: none;
    }
  }

  /* =========================================================
     Mobile Bottom Nav
     ========================================================= */

  .mobile-nav {
    display: none;
  }

  @media (max-width: 50em) {
    .mobile-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      align-items: center;
      justify-content: space-around;
      padding: 0.5rem 1rem;
      padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
      background: var(--gray-999);
      border-top: 2px solid var(--gray-0);
    }

    .mobile-nav a {
      font-family: var(--font-brand);
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      text-decoration: none;
      color: var(--gray-300);
      padding: 0.625rem 0.75rem;
      min-height: 44px;
      display: flex;
      align-items: center;
      transition: color 0.15s ease;
    }

    .mobile-nav a:hover,
    .mobile-nav a[aria-current="page"] {
      color: var(--accent-regular);
    }

    .mobile-nav a:focus-visible {
      outline: 2px solid var(--accent-regular);
      outline-offset: 2px;
    }

    .mobile-nav .mobile-cta {
      background: var(--accent-regular);
      color: var(--accent-text-over);
      padding: 0.5rem 1rem;
    }
  }

  /* Dark mode */
  :root.theme-dark .nav-inner {
    background: var(--gray-999);
    border-color: var(--gray-0);
  }

  :root.theme-dark .nav-cta:hover {
    box-shadow: 4px 4px 0 0 var(--accent-regular);
  }

  :root.theme-dark .mobile-nav {
    background: var(--gray-999);
    border-color: var(--gray-0);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .nav-brand:hover,
    .nav-link:hover,
    .nav-cta:hover {
      transform: none;
    }
  }
</style>
